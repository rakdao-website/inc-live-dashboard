APP_NAME="Innovation City Live Dashboard API"
ENVIRONMENT="development"
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:D%40Postgres@localhost:5433/INC_live_dashboard
AUTO_CREATE_TABLES=true
SEED_SAMPLE_DATA=true
# Admin panel. Generate the secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Create users with: python scripts/create_admin_user.py --username <name> --role super_user
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_MINUTES=480
ADMIN_COOKIE_SECURE=false
SPACEBRING_ENVIRONMENT=sandbox
FACE_WEB_SEARCH_CREDIT_COST=3
FACE_WEB_SEARCH_ENABLED=false
FACE_WEB_SEARCH_PROVIDER=facecheck
FACECHECK_API_TOKEN=
FACE_WEB_SEARCH_TESTING_MODE=true
FACE_WEB_SEARCH_MAX_IMAGES=3
OPENAI_API_KEY=sk-...
# Spacebring (use the sandbox network first; never commit real values)
SPACEBRING_BASE_URL=https://api.spacebring.com
SPACEBRING_CLIENT_ID=
SPACEBRING_CLIENT_SECRET=
SPACEBRING_NETWORK_ID=
SPACEBRING_LOCATION_ID=
SPACEBRING_SYNC_INTERVAL_SECONDS=60

# Extra origins allowed to call the backend (comma separated), e.g. the dashboard display:
# CORS_EXTRA_ORIGINS=
