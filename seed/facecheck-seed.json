{
  "_meta": {
    "description": "Sample (mock) responses for the FaceCheck.ID API, shaped from its OpenAPI spec (https://facecheck.id/swagger/v1/swagger.json). All people, URLs, GUIDs and images are fictional.",
    "baseUrl": "https://facecheck.id",
    "auth": "Authorization: <API_TOKEN> header on every request",
    "notes": [
      "Only fields in the OpenAPI schema are used. 'code' and 'error' string values are illustrative; confirm real values against live responses.",
      "base64 fields are shortened placeholders, not real images.",
      "FaceCheck.ID is a reverse face search over public web images, not a 1:1 verification service. Match urls point to third-party pages."
    ],
    "scenarios": ["info", "upload_pic", "search", "delete_pic", "app_level_results"]
  },

  "info": {
    "POST /api/info": {
      "ok": {
        "status": 200,
        "body": { "faces": 212417831, "is_online": true, "remaining_credits": 394, "has_credits_to_search": true }
      },
      "low_credits": {
        "status": 200,
        "body": { "faces": 212417831, "is_online": true, "remaining_credits": 2, "has_credits_to_search": false }
      },
      "engine_offline": {
        "status": 200,
        "body": { "faces": 212417831, "is_online": false, "remaining_credits": 394, "has_credits_to_search": true }
      }
    }
  },

